---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import Button from '../components/Button.astro';
import Center from '../components/Center.astro';
import Columns from '../components/Columns.astro';
import Gallery from '../components/Gallery.astro';
import Logos from '../components/Logos.astro';
import Social from '../components/Social.astro';
import SubNav from '../components/SubNav.astro';
import Wide from '../components/Wide.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (page) => page.id !== '404');
  return pages.map((page) => ({
    params: { slug: page.id === 'index' ? undefined : page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const slug = page.id === 'index' ? '' : page.id;
const { Content } = await render(page);

// Secondary menu: a page in a folder (skitour-2026/talma-17-1) is a subpage
// of the page named after the folder (skitour-2026). A page with subpages
// gets a row of tabs: itself first, then its direct subpages by date. Each
// level of the current page's path that has subpages adds a row, so an event
// page shows the season's events and then its own "Tulokset | Kilpailukutsu".
const pages = await getCollection('pages');
type Page = (typeof pages)[number];
// Without a navLabel, a tab shows the last part of the title
// ("Moe SkiTour | Talma 17.1.2026" -> "Talma 17.1.2026"), so the shared
// site/section prefix is not repeated on every tab.
const label = (p: Page) => p.data.navLabel ?? p.data.title.split(' | ').at(-1)!;
const byDate = (a: Page, b: Page) =>
  (a.data.date?.getTime() ?? 0) - (b.data.date?.getTime() ?? 0) || a.id.localeCompare(b.id);
const segments = page.id.split('/');
const rows = segments
  .map((_, i) => pages.find((p) => p.id === segments.slice(0, i + 1).join('/')))
  .filter((parent) => parent !== undefined)
  .map((parent) => {
    const children = pages
      .filter((p) => p.id.startsWith(`${parent.id}/`) && !p.id.slice(parent.id.length + 1).includes('/'))
      .sort(byDate);
    return children.length
      ? [{ label: parent.data.contentLabel ?? label(parent), path: parent.id }, ...children.map((p) => ({ label: label(p), path: p.id }))]
      : [];
  })
  .filter((row) => row.length);
const root = pages.find((p) => p.id === segments[0])!;
const sectionTitle = root.data.section ?? root.data.title;
---

<Base {...page.data} slug={slug}>
  {rows.length > 0 && <SubNav title={sectionTitle} rows={rows} slug={slug} variant="tabs" />}
  <Content components={{ Band, Button, Center, Columns, Gallery, Logos, Social, Wide }} />
  {rows.length > 0 && <SubNav title={sectionTitle} rows={rows} slug={slug} variant="pager" />}
</Base>
