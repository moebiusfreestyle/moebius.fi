---
// Full-width photo band with a centred heading and an optional button.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  image: string | ImageMetadata;
  heading: string;
  // A logo shown in place of the heading text, which becomes its alt text.
  logo?: ImageMetadata;
  cta?: { label: string; href: string };
  level?: 1 | 2;
  // Middle of the heading, as % of the band's height from the top.
  headingAt?: number;
  // Point of the photo kept in view when narrow screens crop its sides,
  // as % of its width from the left.
  focusX?: number;
  // The blue tint over a page hero (.band-tint); false shows the photo as it is.
  tint?: boolean;
}

const { image, heading, logo, cta, level = 2, headingAt, focusX, tint = true } = Astro.props;
const meta = resolveImage(image);
// Photos are served 1600 px wide, unless a sharper, larger-than-1920 px
// source was provided on purpose (the front page): that is kept up to 3840 px.
const width = meta.width > 1920 ? Math.min(meta.width, 3840) : 1600;
// The tint hides fine detail, so a tinted photo can be compressed harder.
const quality = level === 1 && tint ? 60 : undefined;
const bg = await getImage({ src: meta, width, format: 'webp', quality });
// A page hero keeps the photo's own proportions, so the whole picture is
// shown at any width instead of a zoomed, cropped slice.
const ratio = level === 1 ? `;aspect-ratio:${meta.width}/${meta.height}` : '';
const Heading = level === 1 ? 'h1' : 'h2';
const placed = headingAt === undefined ? '' : `;--heading-at:${headingAt}%`;
const focus = focusX === undefined ? '' : `;background-position:${focusX}% center`;
---

<section class:list={['band', { 'band-placed': placed, 'band-tint': level === 1 && tint }]} style={`background-image:url(${bg.src})${ratio}${placed}${focus}`}>
  <Heading class:list={{ 'band-logo': logo }}>
    {logo ? <Image src={logo} alt={heading} width={Math.min(logo.width, 1280)} loading="eager" /> : heading}
  </Heading>
  {cta && <p><a href={cta.href}>{cta.label}</a></p>}
</section>
